# ==============================================================================
# Monolithic-LMS Environment Variables (.env)
# Copy this file to .env: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (MySQL / TiDB)
# Default points to local Docker MySQL (port 3307 mapped to container 3306)
# ------------------------------------------------------------------------------
TIDB_URL=jdbc:mysql://localhost:3307/dlms_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
TIDB_USER=root
TIDB_PASSWORD=root

# ------------------------------------------------------------------------------
# 2. MongoDB Configuration (Course & Media metadata)
# Default points to local Docker MongoDB (port 27017)
# ------------------------------------------------------------------------------
COURSE_MONGODB_URI=mongodb://localhost:27017/dlms_mongo_db
MONGODB_URI=mongodb://localhost:27017/dlms_mongo_db

# ------------------------------------------------------------------------------
# 3. Security & JWT
# Minimum 256-bit secret key for HMAC SHA algorithms
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ------------------------------------------------------------------------------
# 4. External Services (Optional for basic local boot)
# ------------------------------------------------------------------------------
# Pinata / IPFS (Get free keys at pinata.cloud for course media uploads)
PINATA_API_KEY=
PINATA_SECRET_API_KEY=
PINATA_JWT=

# Hugging Face API Token (Get token at huggingface.co/settings/tokens for AI chatbot)
HF_TOKEN=

# Service Endpoints
CHATBOT_SERVICE_URL=http://localhost:8000
REACT_APP_API_GATEWAY_URL=http://localhost:8080
